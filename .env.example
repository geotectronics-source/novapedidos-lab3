# Copie este archivo como .env y complete OPENROUTER_API_KEY.
#   PowerShell:  Copy-Item .env.example .env

# --- Modelo de lenguaje (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelo elegido con la comparación de evidencia/comparacion/ANALISIS.md (DECISIONES.md D18).
MODELO_LLM=anthropic/claude-haiku-5.5
# Modelo alterno, de otro proveedor, si el principal falla (límite de solicitudes, caída). Vacío = sin respaldo.
MODELO_LLM_RESPALDO=openai/gpt-6-luna
LLM_TEMPERATURA=0
LLM_TIMEOUT_S=30
LLM_MAX_REINTENTOS=2
# function_calling (compatible con más modelos) | json_schema
LLM_METODO_SALIDA=function_calling
# hibrida (recomendada) | determinista | llm  — ver DECISIONES.md
ESTRATEGIA_RESOLUCION=hibrida

# --- Datos publicados (carpeta que contiene datos/, politicas.md y ejemplos/) ---
DATA_DIR=lab3

# --- Observabilidad ---
# Fuera de Docker: dirección del MLflow local. Dentro de docker compose la API usa http://mlflow:5000
# (lo fija docker-compose.yml, no hace falta cambiarlo aquí).
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENTO=novapedidos
MLFLOW_TIMEOUT_S=2
# false = no enviar trazas (la API funciona igual)
TRAZAS_ACTIVAS=true
